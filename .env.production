# Production Environment Configuration
# These values will be overridden by GitHub Secrets at deployment time

# Gemini AI API Configuration
GEMINI_API_KEY="$GEMINI_API_KEY"

# Application URL
APP_URL="https://your-production-domain.com"

# ⚠️ SECURITY: Never hardcode credentials in this file!
# Set the following in GitHub Secrets or your deployment platform:
# - ADMIN_EMAIL
# - ADMIN_PASSWORD
# - TRADER_EMAIL
# - TRADER_PASSWORD

# Environment indicator
NODE_ENV="production"
